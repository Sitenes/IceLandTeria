            }

            /* Ensure RTL numbers and punctuation work seamlessly */
            body {
                direction: rtl;
                text-align: right;
            }

            /* ── Card Menu Styles ── */
            .menu-card-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
                gap: 1.6rem;
                padding: 2rem 0;
                direction: rtl;
            }

            .menu-card {
                background: var(--color-bg, #fff);
                border-radius: 12px;
                padding: 1.8rem 1.6rem;
                box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
                transition: transform 0.3s ease, box-shadow 0.3s ease;
                display: flex;
                flex-direction: column;
            }

            .menu-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
            }

            .menu-card__header {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                margin-bottom: 0.6rem;
                gap: 1rem;
            }

            .menu-card__name {
                font-size: 1.6rem;
                font-weight: 700;
                color: var(--color-1, #1e1e1e);
                line-height: 1.4;
                margin: 0;
            }

            .menu-card__price {
                font-size: 1.5rem;
                font-weight: 700;
                color: var(--color-2, #c8a97e);
                white-space: nowrap;
                flex-shrink: 0;
            }

            .menu-card__desc {
                font-size: 1.3rem;
                color: var(--color-text-light, #888);
                line-height: 1.7;
                margin: 0;
            }

            @@media (max-width: 600px) {
                .menu-card-grid {
                    grid-template-columns: 1fr;
                }
            }

            /* ── About & Contact Combined Section (Luxurious) ── */
            .s-about-contact {
                padding-top: var(--vspace-5);
                position: relative;
            }

            .s-about-contact::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 1px;
                background: linear-gradient(90deg, transparent, var(--color-2-500), transparent);
            }

            .about-contact__grid {
                display: flex;
                margin-top: 2rem;
            }

            .about-contact__card {
                background: linear-gradient(145deg, rgba(255, 255, 255, 0.03), rgba(200, 169, 126, 0.05));
                border: 1px solid rgba(200, 169, 126, 0.12);
                border-radius: 20px;
                padding: 3rem 2.5rem;
                height: 100%;
                backdrop-filter: blur(10px);
                transition: all 0.4s var(--ease-smooth-in-out);
                position: relative;
                overflow: hidden;
            }

            .about-contact__card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: linear-gradient(90deg, var(--color-1-500), var(--color-2-500), var(--color-1-500));
                background-size: 200% 100%;
                animation: shimmer 3s ease-in-out infinite;
            }

            @@keyframes shimmer {

                0%,
                100% {
                    background-position: 0% 0%;
                }

                50% {
                    background-position: 100% 0%;
                }
            }

            .about-contact__card:hover {
                border-color: rgba(200, 169, 126, 0.3);
                transform: translateY(-4px);
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            }

            .about-contact__card h3 {
                font-size: 2.2rem;
                font-weight: 700;
                color: var(--color-2-400);
                margin-bottom: 2rem;
                position: relative;
                padding-bottom: 1.2rem;
            }

            .about-contact__card h3::after {
                content: '';
                position: absolute;
                bottom: 0;
                right: 0;
                width: 50px;
                height: 2px;
                background: linear-gradient(90deg, var(--color-2-500), transparent);
            }

            .about-contact__story .story-badge {
                display: inline-block;
                background: linear-gradient(135deg, var(--color-1-600), var(--color-2-600));
                color: #fff;
                font-size: 1.35rem;
                font-weight: 600;
                padding: 0.5rem 1.6rem;
                border-radius: 50px;
                margin-bottom: 1.5rem;
                letter-spacing: 0.5px;
            }

            .about-contact__story .story-quote {
                font-size: 2.4rem;
                font-weight: 700;
                color: var(--color-1-400);
                line-height: 1.7;
                margin-bottom: 1.5rem;
            }

            .about-contact__story .story-text {
                font-size: 1.7rem;
                line-height: 2.3;
                color: var(--color-text);
                margin-bottom: 2rem;
                opacity: 0.9;
            }

            .about-contact__info {
                list-style: none;
                padding: 0;
                margin: 2rem 0 0;
                display: flex;
                flex-direction: column;
                gap: 1rem;
            }

            .about-contact__info li {
                display: flex;
                align-items: center;
                gap: 1rem;
                font-size: 1.5rem;
                color: var(--color-text-light);
            }

            .about-contact__info li .info-icon {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: linear-gradient(135deg, rgba(200, 169, 126, 0.15), rgba(214, 72, 135, 0.1));
                border: 1px solid rgba(200, 169, 126, 0.2);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

            .about-contact__info li .info-icon svg {
                width: 16px;
                height: 16px;
                fill: var(--color-2-500);
            }

            .about-contact__info li a {
                color: var(--color-2-400);
                text-decoration: none;
                transition: color 0.3s;
            }

            .about-contact__info li a:hover {
                color: var(--color-1-400);
            }

            /* ── Contact Form Styles ── */
            .about-contact__form .form-group {
                margin-bottom: 1.8rem;
            }

            .about-contact__form label {
                font-size: 1.2rem;
                font-weight: 600;
                color: var(--color-2-400);
                margin-bottom: 0.6rem;
                display: block;
            }

            .about-contact__form input,
            .about-contact__form textarea,
            .about-contact__form select {
                width: 100%;
                background: rgba(255, 255, 255, 0.03);
                border: 1px solid rgba(200, 169, 126, 0.15);
                border-radius: 12px;
                padding: 1.2rem 1.6rem;
                color: var(--color-text);
                font-size: 1.4rem;
                font-family: inherit;
                transition: all 0.3s var(--ease-smooth-in-out);
                outline: none;
                height: auto;
                line-height: 1.6;
            }

            .about-contact__form input:focus,
            .about-contact__form textarea:focus,
            .about-contact__form select:focus {
                border-color: var(--color-2-500);
                background: rgba(255, 255, 255, 0.06);
                box-shadow: 0 0 0 3px rgba(200, 169, 126, 0.1);
            }

            .about-contact__form input::placeholder,
            .about-contact__form textarea::placeholder {
                color: rgba(255, 255, 255, 0.25);
                font-size: 1.3rem;
            }

            .about-contact__form textarea {
                min-height: 120px;
                resize: vertical;
            }

            .about-contact__form .ss-custom-select {
                position: relative;
            }

            .about-contact__form .ss-custom-select::after {
                border-bottom: 1px solid var(--color-2-500);
                border-right: 1px solid var(--color-2-500);
                content: '';
                display: block;
                height: 8px;
                width: 8px;
                pointer-events: none;
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%) rotate(45deg);
                transition: all 0.3s;
            }

            .about-contact__form .submit-btn {
                width: 100%;
                padding: 1.4rem 2rem;
                background: linear-gradient(135deg, var(--color-1-600), var(--color-2-600));
                border: none;
                border-radius: 12px;
                color: #fff;
                font-size: 1.5rem;
                font-weight: 700;
                font-family: inherit;
                cursor: pointer;
                transition: all 0.4s var(--ease-smooth-in-out);
                position: relative;
                overflow: hidden;
                letter-spacing: 0.5px;
            }

            .about-contact__form .submit-btn::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: linear-gradient(135deg, var(--color-2-600), var(--color-1-600));
                opacity: 0;
                transition: opacity 0.4s;
            }

            .about-contact__form .submit-btn:hover::before {
                opacity: 1;
            }

            .about-contact__form .submit-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 30px rgba(200, 169, 126, 0.3);
            }

            .about-contact__form .submit-btn span {
                position: relative;
                z-index: 1;
            }

            @@media (max-width: 800px) {
                .about-contact__grid {
                    flex-direction: column;
                }

                .about-contact__card {
                    padding: 2rem 1.6rem;
                }
            }

            /* ── Maps Container ── */
            .about-contact__maps {
                margin-top: 3rem;
                border-radius: 20px;
                overflow: hidden;
                border: 1px solid rgba(200, 169, 126, 0.12);
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
                transition: all 0.4s var(--ease-smooth-in-out);
                position: relative;
            }

            .about-contact__maps:hover {
                border-color: rgba(200, 169, 126, 0.3);
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
            }

            .about-contact__maps iframe {
                display: block;
                width: 100%;
                height: 380px;
                border: 0;
            }

            @@media (max-width: 600px) {
                .about-contact__maps iframe {
                    height: 260px;
                }
            }
    </style>

